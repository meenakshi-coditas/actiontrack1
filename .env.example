# Copy to .env (never commit) or set in the shell. All values optional; no credentials are used by actiontrack itself.

# SQLite database file (default: ./.actiontrack/actiontrack.db)
ACTIONTRACK_DB=

# Override "today" (YYYY-MM-DD) for overdue calculations. Default: current date in ACTIONTRACK_TZ.
ACTIONTRACK_TODAY=

# IANA timezone used to decide "today" (default: system timezone), e.g. Asia/Kolkata
ACTIONTRACK_TZ=

# Optional JSON file of trusted contacts: { "Priya Sharma": "priya.sharma@example.com" }
ACTIONTRACK_CONTACTS=

# Optional ES module exporting { createDraft({to, subject, body}) } that talks to a Gmail draft API/MCP bridge.
# Gmail credentials, if any, belong to that module's own environment - never to this repo.
ACTIONTRACK_GATEWAY=
